#include <stdio.h>
#include <limits.h>

#define N 5

char cities[N] = {'A', 'B', 'C', 'D', 'E'};

int dist[N][N] = {
    {0, 10, 15, 20, 25},
    {10, 0, 35, 25, 30},
    {15, 35, 0, 30, 20},
    {20, 25, 30, 0, 15},
    {25, 30, 20, 15, 0}
};

int visited[N];
int path[N + 1];
int bestPath[N + 1];
int minDistance = INT_MAX;

/* TSP using backtracking */
void tsp(int current, int count, int totalDistance) {

    /* All cities have been visited */
    if (count == N) {

        /* Return to starting city A */
        int finalDistance = totalDistance + dist[current][0];

        if (finalDistance < minDistance) {
            minDistance = finalDistance;

            for (int i = 0; i < N; i++)
                bestPath[i] = path[i];

            bestPath[N] = 0;
        }

        return;
    }

    /* Try every unvisited city */
    for (int i = 1; i < N; i++) {

        if (!visited[i]) {

            visited[i] = 1;
            path[count] = i;

            tsp(i, count + 1,
                totalDistance + dist[current][i]);

            visited[i] = 0;
        }
    }
}

int main() {

    /* Start from city A */
    visited[0] = 1;
    path[0] = 0;

    tsp(0, 1, 0);

    printf("Shortest Route: ");

    for (int i = 0; i <= N; i++) {
        printf("%c", cities[bestPath[i]]);

        if (i < N)
            printf(" -> ");
    }

    printf("\n");

    printf("Minimum Distance: %d\n", minDistance);

    return 0;
}
