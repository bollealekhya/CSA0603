#include <stdio.h>

void printArray(int a[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d", a[i]);
        if (i < n - 1)
            printf(", ");
    }
    printf("\n");
}

int partition(int a[], int low, int high) {
    int pivot = a[(low + high) / 2];
    int i = low;
    int j = high;
    int temp;

    while (i <= j) {

        while (a[i] < pivot)
            i++;

        while (a[j] > pivot)
            j--;

        if (i <= j) {
            temp = a[i];
            a[i] = a[j];
            a[j] = temp;

            i++;
            j--;
        }
    }

    return i;
}

void quickSort(int a[], int low, int high, int n) {
    if (low < high) {

        int index = partition(a, low, high);

        printf("After partition: ");
        printArray(a, n);

        quickSort(a, low, index - 1, n);
        quickSort(a, index, high, n);
    }
}

int main() {
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int a[n];

    printf("Enter the elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("\nOriginal Array: ");
    printArray(a, n);

    printf("\nQuick Sort Steps:\n");

    quickSort(a, 0, n - 1, n);

    printf("\nSorted Array: ");
    printArray(a, n);

    return 0;
}
