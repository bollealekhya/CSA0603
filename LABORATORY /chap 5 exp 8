#include <stdio.h>
#include <stdlib.h>

#define MAX 100

typedef struct Node
{
    char ch;
    int freq;
    struct Node *left;
    struct Node *right;
} Node;

/* Create a new node */
Node* createNode(char ch, int freq)
{
    Node *node = (Node*)malloc(sizeof(Node));

    node->ch = ch;
    node->freq = freq;
    node->left = NULL;
    node->right = NULL;

    return node;
}

/* Find node with minimum frequency */
int findMin(Node *nodes[], int size)
{
    int minIndex = 0;

    for (int i = 1; i < size; i++)
    {
        if (nodes[i]->freq < nodes[minIndex]->freq)
            minIndex = i;
    }

    return minIndex;
}

/* Build Huffman Tree */
Node* buildHuffmanTree(char characters[],
                       int frequencies[],
                       int n)
{
    Node *nodes[MAX];
    int size = n;

    /* Create leaf nodes */
    for (int i = 0; i < n; i++)
    {
        nodes[i] = createNode(characters[i],
                              frequencies[i]);
    }

    /* Combine two smallest nodes */
    while (size > 1)
    {
        int min1 = findMin(nodes, size);
        Node *left = nodes[min1];

        nodes[min1] = nodes[size - 1];
        size--;

        int min2 = findMin(nodes, size);
        Node *right = nodes[min2];

        nodes[min2] = nodes[size - 1];
        size--;

        Node *parent = createNode('$',
                                  left->freq +
                                  right->freq);

        parent->left = left;
        parent->right = right;

        nodes[size] = parent;
        size++;
    }

    return nodes[0];
}

/* Decode Huffman encoded string */
void decode(Node *root, const char encoded[])
{
    Node *current = root;

    printf("\"");

    for (int i = 0; encoded[i] != '\0'; i++)
    {
        if (encoded[i] == '0')
            current = current->left;
        else if (encoded[i] == '1')
            current = current->right;

        /* Leaf node reached */
        if (current->left == NULL &&
            current->right == NULL)
        {
            printf("%c", current->ch);
            current = root;
        }
    }

    printf("\"\n");
}

/* Free Huffman tree */
void freeTree(Node *root)
{
    if (root == NULL)
        return;

    freeTree(root->left);
    freeTree(root->right);

    free(root);
}

int main()
{
    /* ================= TEST CASE 1 ================= */

    char characters1[] = {'a', 'b', 'c', 'd'};
    int frequencies1[] = {5, 9, 12, 13};

    char encoded1[] = "1101100111110";

    Node *root1 = buildHuffmanTree(
        characters1,
        frequencies1,
        4
    );

    printf("Test Case 1:\n");
    printf("Encoded String: %s\n", encoded1);
    printf("Decoded Message: ");

    decode(root1, encoded1);

    freeTree(root1);


    /* ================= TEST CASE 2 ================= */

    char characters2[] =
        {'f', 'e', 'd', 'c', 'b', 'a'};

    int frequencies2[] =
        {5, 9, 12, 13, 16, 45};

    char encoded2[] =
        "110011011100101111001011";

    Node *root2 = buildHuffmanTree(
        characters2,
        frequencies2,
        6
    );

    printf("\nTest Case 2:\n");
    printf("Encoded String: %s\n", encoded2);
    printf("Decoded Message: ");

    decode(root2, encoded2);

    freeTree(root2);

    return 0;
}
