#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int u, v, w;
} Edge;

/* Find parent */
int find(int parent[], int x)
{
    if (parent[x] != x)
        parent[x] = find(parent, parent[x]);

    return parent[x];
}

/* Union two sets */
void unionSet(int parent[], int rank[], int x, int y)
{
    x = find(parent, x);
    y = find(parent, y);

    if (x == y)
        return;

    if (rank[x] < rank[y])
        parent[x] = y;
    else if (rank[x] > rank[y])
        parent[y] = x;
    else
    {
        parent[y] = x;
        rank[x]++;
    }
}

/* Compare edges according to weight */
int compare(const void *a, const void *b)
{
    Edge *e1 = (Edge *)a;
    Edge *e2 = (Edge *)b;

    return e1->w - e2->w;
}

/* Check whether two edges are the same */
int sameEdge(Edge a, Edge b)
{
    return ((a.u == b.u && a.v == b.v) ||
            (a.u == b.v && a.v == b.u));
}

/* Calculate weight of given MST */
int mstWeight(Edge mst[], int n)
{
    int total = 0;

    for (int i = 0; i < n - 1; i++)
        total += mst[i].w;

    return total;
}

/*
 * Find another MST after excluding one edge
 */
int findAlternativeMST(int n, int m, Edge edges[],
                       Edge givenMST[], int removed,
                       Edge alternative[])
{
    int parent[n];
    int rank[n];

    for (int i = 0; i < n; i++)
    {
        parent[i] = i;
        rank[i] = 0;
    }

    int count = 0;
    int total = 0;

    for (int i = 0; i < m; i++)
    {
        if (sameEdge(edges[i], givenMST[removed]))
            continue;

        int u = edges[i].u;
        int v = edges[i].v;

        if (find(parent, u) != find(parent, v))
        {
            unionSet(parent, rank, u, v);

            alternative[count++] = edges[i];
            total += edges[i].w;

            if (count == n - 1)
                break;
        }
    }

    if (count == n - 1)
        return total;

    return -1;
}

/* Verify uniqueness */
void checkUnique(int n, int m, Edge edges[],
                 Edge givenMST[])
{
    qsort(edges, m, sizeof(Edge), compare);

    int givenWeight = mstWeight(givenMST, n);

    Edge alternative[n - 1];

    for (int i = 0; i < n - 1; i++)
    {
        int weight = findAlternativeMST(
            n, m, edges, givenMST, i, alternative
        );

        if (weight == givenWeight)
        {
            printf("Is the given MST unique? False\n");

            printf("Another possible MST: [");

            for (int j = 0; j < n - 1; j++)
            {
                printf("(%d, %d, %d)",
                       alternative[j].u,
                       alternative[j].v,
                       alternative[j].w);

                if (j < n - 2)
                    printf(", ");
            }

            printf("]\n");
            return;
        }
    }

    printf("Is the given MST unique? True\n");
}

int main()
{
    /* ================= TEST CASE 1 ================= */

    Edge edges1[] =
    {
        {0, 1, 10},
        {0, 2, 6},
        {0, 3, 5},
        {1, 3, 15},
        {2, 3, 4}
    };

    Edge mst1[] =
    {
        {2, 3, 4},
        {0, 3, 5},
        {0, 1, 10}
    };

    printf("Test Case 1:\n");

    checkUnique(4, 5, edges1, mst1);


    /* ================= TEST CASE 2 ================= */

    Edge edges2[] =
    {
        {0, 1, 1},
        {0, 2, 1},
        {1, 3, 2},
        {2, 3, 2},
        {3, 4, 3},
        {4, 2, 3}
    };

    Edge mst2[] =
    {
        {0, 1, 1},
        {0, 2, 1},
        {1, 3, 2},
        {3, 4, 3}
    };

    printf("\nTest Case 2:\n");

    checkUnique(5, 6, edges2, mst2);

    return 0;
}
