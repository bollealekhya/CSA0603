#include <iostream>
#include <vector>
#include <string>
using namespace std;

bool isPalindrome(string s) {
    int left = 0;
    int right = s.length() - 1;

    while (left < right) {
        if (s[left] != s[right])
            return false;

        left++;
        right--;
    }

    return true;
}

string firstPalindromic(vector<string>& words) {
    for (string word : words) {
        if (isPalindrome(word))
            return word;
    }

    return "";
}

int main() {
    vector<string> words1 = {"abc", "car", "ada", "racecar", "cool"};
    vector<string> words2 = {"notapalindrome", "racecar"};

    cout << "Output 1: " << firstPalindromic(words1) << endl;
    cout << "Output 2: " << firstPalindromic(words2) << endl;

    return 0;
}
