def median_of_medians(arr, k):
    # k is 1-based
    if k < 1 or k > len(arr):
        return None

    # Base case
    if len(arr) <= 5:
        return sorted(arr)[k - 1]

    # Divide array into groups of 5
    groups = []

    for i in range(0, len(arr), 5):
        group = arr[i:i + 5]
        groups.append(sorted(group))

    # Find the median of each group
    medians = []

    for group in groups:
        middle = len(group) // 2
        medians.append(group[middle])

    # Find the median of the medians
    pivot = median_of_medians(medians, (len(medians) + 1) // 2)

    # Partition the array
    smaller = [x for x in arr if x < pivot]
    equal = [x for x in arr if x == pivot]
    larger = [x for x in arr if x > pivot]

    # Determine which part contains the k-th element
    if k <= len(smaller):
        return median_of_medians(smaller, k)

    elif k <= len(smaller) + len(equal):
        return pivot

    else:
        new_k = k - len(smaller) - len(equal)
        return median_of_medians(larger, new_k)


