#include <stdio.h>

int binarySearch(int a[], int n, int key, int *comparisons) {
    int low = 0;
    int high = n - 1;

    *comparisons = 0;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        (*comparisons)++;

        if (a[mid] == key) {
            return mid;
        }
        else if (a[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    return -1;
}

int main() {
    int n, key, comparisons;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int a[n];

    printf("Enter sorted elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("Enter search key: ");
    scanf("%d", &key);

    int index = binarySearch(a, n, key, &comparisons);

    if (index != -1) {
        printf("Element found at index: %d\n", index);
        printf("Position: %d\n", index + 1);
    } else {
        printf("Element not found\n");
    }

    printf("Number of comparisons: %d\n", comparisons);

    return 0;
}
