#include <stdio.h>

#define MAXN 50

#define DRAW  0
#define MOUSE 1
#define CAT   2

int graph[MAXN][MAXN];
int degree[MAXN];

int color[MAXN][MAXN][2];
int result[MAXN][MAXN][2];

typedef struct {
    int mouse;
    int cat;
    int turn;
    int result;
} State;

State queue[MAXN * MAXN * 2];
int front = 0, rear = 0;

/* Add state to queue */
void enqueue(int mouse, int cat, int turn, int resultValue)
{
    result[mouse][cat][turn] = resultValue;

    queue[rear].mouse = mouse;
    queue[rear].cat = cat;
    queue[rear].turn = turn;
    queue[rear].result = resultValue;

    rear++;
}

/*
   Find all previous states that can move
   into the current state.
*/
void getPreviousStates(int mouse, int cat, int turn,
                       int pmouse[], int *pmouseCount,
                       int pcat[], int *pcatCount)
{
    *pmouseCount = 0;
    *pcatCount = 0;

    if (turn == 0) {
        /*
           Current turn is Mouse.
           Previous turn was Cat.
           Cat could have moved to current cat.
        */
        for (int i = 0; i < degree[cat]; i++) {
            int previousCat = graph[cat][i];

            /* Cat cannot move to the hole */
            if (previousCat == 0)
                continue;

            pcat[(*pcatCount)++] = previousCat;
        }
    }
    else {
        /*
           Current turn is Cat.
           Previous turn was Mouse.
        */
        for (int i = 0; i < degree[mouse]; i++) {
            int previousMouse = graph[mouse][i];
            pmouse[(*pmouseCount)++] = previousMouse;
        }
    }
}

/* Solve Cat and Mouse Game */
int catMouseGame(int n)
{
    int moves[MAXN][MAXN][2];

    /* Initialize all states */
    for (int m = 0; m < n; m++) {
        for (int c = 0; c < n; c++) {

            for (int turn = 0; turn < 2; turn++) {
                result[m][c][turn] = DRAW;
                moves[m][c][turn] = 0;
            }

            /* Number of possible moves for Mouse */
            moves[m][c][0] = degree[m];

            /* Number of legal moves for Cat */
            int count = 0;

            for (int i = 0; i < degree[c]; i++) {
                if (graph[c][i] != 0)
                    count++;
            }

            moves[m][c][1] = count;
        }
    }

    /*
       Terminal states:
       Mouse reaches hole -> Mouse wins
       Mouse and Cat occupy same node -> Cat wins
    */

    for (int c = 1; c < n; c++) {

        /* Mouse at hole */
        enqueue(0, c, 0, MOUSE);
        enqueue(0, c, 1, MOUSE);
    }

    for (int i = 1; i < n; i++) {

        /* Cat catches Mouse */
        enqueue(i, i, 0, CAT);
        enqueue(i, i, 1, CAT);
    }

    /* Retrograde BFS */
    while (front < rear) {

        State current = queue[front++];

        int m = current.mouse;
        int c = current.cat;
        int turn = current.turn;
        int outcome = current.result;

        int pmouse[MAXN];
        int pcat[MAXN];

        int pmouseCount;
        int pcatCount;

        getPreviousStates(
            m, c, turn,
            pmouse, &pmouseCount,
            pcat, &pcatCount
        );

        /*
           Previous turn was Cat
        */
        if (turn == 0) {

            for (int i = 0; i < pcatCount; i++) {

                int previousCat = pcat[i];

                if (result[m][previousCat][1] != DRAW)
                    continue;

                /*
                   Cat wants Cat-win.
                   If current result is CAT,
                   Cat can choose this move.
                */
                if (outcome == CAT) {

                    enqueue(
                        m,
                        previousCat,
                        1,
                        CAT
                    );
                }
                else {

                    /*
                       This move does not give Cat
                       a winning result.
                    */
                    moves[m][previousCat][1]--;

                    /*
                       If all Cat's moves lead to
                       Mouse winning, Mouse wins.
                    */
                    if (moves[m][previousCat][1] == 0) {

                        enqueue(
                            m,
                            previousCat,
                            1,
                            MOUSE
                        );
                    }
                }
            }
        }

        /*
           Previous turn was Mouse
        */
        else {

            for (int i = 0; i < pmouseCount; i++) {

                int previousMouse = pmouse[i];

                if (result[previousMouse][c][0] != DRAW)
                    continue;

                /*
                   Mouse wants Mouse-win.
                   If current result is MOUSE,
                   Mouse can choose this move.
                */
                if (outcome == MOUSE) {

                    enqueue(
                        previousMouse,
                        c,
                        0,
                        MOUSE
                    );
                }
                else {

                    /*
                       This move does not give Mouse
                       a winning result.
                    */
                    moves[previousMouse][c][0]--;

                    /*
                       If all Mouse moves lead to
                       Cat winning, Cat wins.
                    */
                    if (moves[previousMouse][c][0] == 0) {

                        enqueue(
                            previousMouse,
                            c,
                            0,
                            CAT
                        );
                    }
                }
            }
        }
    }

    /*
       Initial position:
       Mouse = 1
       Cat = 2
       Mouse moves first (turn = 0)
    */
    return result[1][2][0];
}

/* Add graph */
void addGraph(int n, int edges[][MAXN])
{
    for (int i = 0; i < n; i++) {
        degree[i] = 0;

        for (int j = 0; j < n; j++) {
            graph[i][j] = 0;
        }
    }

    for (int i = 0; i < n; i++) {
        degree[i] = edges[i][0];

        for (int j = 1; j <= degree[i]; j++) {
            graph[i][j - 1] = edges[i][j];
        }
    }
}

int main()
{
    /* Example 1 */
    int graph1[6][MAXN] = {
        {2, 2, 5},
        {1, 3},
        {3, 0, 4, 5},
        {3, 1, 4, 5},
        {2, 2, 3},
        {3, 0, 2, 3}
    };

    addGraph(6, graph1);

    front = 0;
    rear = 0;

    printf("Example 1:\n");
    printf("Output: %d\n", catMouseGame(6));

    /*
       Example 2
    */
    int graph2[4][MAXN] = {
        {2, 1, 3},
        {1, 0},
        {1, 3},
        {2, 0, 2}
    };

    addGraph(4, graph2);

    front = 0;
    rear = 0;

    printf("\nExample 2:\n");
    printf("Output: %d\n", catMouseGame(4));

    return 0;
}
