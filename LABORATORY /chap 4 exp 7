#include <stdio.h>
#include <string.h>

int lengthOfLongestSubstring(char s[]) {
    int last[256];
    
    // Initialize last occurrence of every character to -1
    for (int i = 0; i < 256; i++)
        last[i] = -1;

    int start = 0;
    int maxLength = 0;

    for (int i = 0; s[i] != '\0'; i++) {

        unsigned char ch = s[i];

        // If character appeared inside current window
        if (last[ch] >= start) {
            start = last[ch] + 1;
        }

        last[ch] = i;

        int currentLength = i - start + 1;

        if (currentLength > maxLength)
            maxLength = currentLength;
    }

    return maxLength;
}

int main() {
    char s[50001];

    printf("Enter string: ");
    fgets(s, sizeof(s), stdin);

    // Remove newline
    s[strcspn(s, "\n")] = '\0';

    int result = lengthOfLongestSubstring(s);

    printf("Length of longest substring without repeating characters: %d\n",
           result);

    return 0;
}
