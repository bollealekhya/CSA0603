#include <stdio.h>

int uniquePaths(int m, int n) {
    int dp[m][n];

    // First row: only right moves
    for (int j = 0; j < n; j++)
        dp[0][j] = 1;

    // First column: only down moves
    for (int i = 0; i < m; i++)
        dp[i][0] = 1;

    // Fill remaining cells
    for (int i = 1; i < m; i++) {
        for (int j = 1; j < n; j++) {
            dp[i][j] = dp[i - 1][j] + dp[i][j - 1];
        }
    }

    return dp[m - 1][n - 1];
}

int main() {
    int m, n;

    printf("Enter rows and columns: ");
    scanf("%d %d", &m, &n);

    printf("Number of unique paths: %d\n", uniquePaths(m, n));

    return 0;
}
