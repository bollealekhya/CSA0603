#include <iostream>
using namespace std;

// Merge two sorted parts
void merge(int arr[], int left, int mid, int right) {
    int n1 = mid - left + 1;
    int n2 = right - mid;

    int L[n1], R[n2];

    for (int i = 0; i < n1; i++)
        L[i] = arr[left + i];

    for (int j = 0; j < n2; j++)
        R[j] = arr[mid + 1 + j];

    int i = 0, j = 0, k = left;

    while (i < n1 && j < n2) {
        if (L[i] <= R[j])
            arr[k++] = L[i++];
        else
            arr[k++] = R[j++];
    }

    while (i < n1)
        arr[k++] = L[i++];

    while (j < n2)
        arr[k++] = R[j++];
}

// Merge Sort
void mergeSort(int arr[], int left, int right) {
    if (left < right) {
        int mid = left + (right - left) / 2;

        mergeSort(arr, left, mid);
        mergeSort(arr, mid + 1, right);

        merge(arr, left, mid, right);
    }
}

// Find maximum after sorting
void findMaximum(int arr[], int n) {
    if (n == 0) {
        cout << "The list is empty." << endl;
        return;
    }

    mergeSort(arr, 0, n - 1);

    // Maximum is the last element after sorting
    cout << "Maximum element: " << arr[n - 1] << endl;
}

int main() {

    // Test Case 1: Empty List
    int arr1[] = {};
    cout << "Test Case 1: ";
    findMaximum(arr1, 0);

    // Test Case 2: Single Element
    int arr2[] = {5};
    cout << "Test Case 2: ";
    findMaximum(arr2, 1);

    // Test Case 3: All Elements Same
    int arr3[] = {3, 3, 3, 3, 3};
    cout << "Test Case 3: ";
    findMaximum(arr3, 5);

    return 0;
}
