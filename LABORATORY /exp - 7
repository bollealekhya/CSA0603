#include <iostream>
#include <vector>
#include <unordered_set>
using namespace std;

vector<int> findUnique(vector<int>& nums) {
    unordered_set<int> seen;
    vector<int> unique;

    for (int num : nums) {
        // Insert only if the element is not already present
        if (seen.find(num) == seen.end()) {
            seen.insert(num);
            unique.push_back(num);
        }
    }

    return unique;
}

void display(vector<int> result) {
    cout << "[";
    for (int i = 0; i < result.size(); i++) {
        cout << result[i];
        if (i < result.size() - 1)
            cout << ", ";
    }
    cout << "]" << endl;
}

int main() {

    vector<int> nums1 = {3, 7, 3, 5, 2, 5, 9, 2};
    vector<int> nums2 = {-1, 2, -1, 3, 2, -2};
    vector<int> nums3 = {1000000, 999999, 1000000};

    cout << "Test Case 1: ";
    display(findUnique(nums1));

    cout << "Test Case 2: ";
    display(findUnique(nums2));

    cout << "Test Case 3: ";
    display(findUnique(nums3));

    return 0;
}
