#include <stdio.h>

/* Swap two elements */
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

/* Insertion sort for small groups */
void insertionSort(int arr[], int left, int right) {
    for (int i = left + 1; i <= right; i++) {
        int key = arr[i];
        int j = i - 1;

        while (j >= left && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }

        arr[j + 1] = key;
    }
}

/* Partition array around a pivot */
int partition(int arr[], int left, int right, int pivotIndex) {
    int pivotValue = arr[pivotIndex];

    swap(&arr[pivotIndex], &arr[right]);

    int storeIndex = left;

    for (int i = left; i < right; i++) {
        if (arr[i] < pivotValue) {
            swap(&arr[storeIndex], &arr[i]);
            storeIndex++;
        }
    }

    swap(&arr[storeIndex], &arr[right]);

    return storeIndex;
}

/* Find median of a small group */
int findMedian(int arr[], int left, int right) {
    insertionSort(arr, left, right);

    return left + (right - left) / 2;
}

/* Median of Medians */
int medianOfMedians(int arr[], int left, int right) {
    int n = right - left + 1;

    /* If the group contains 5 or fewer elements */
    if (n <= 5) {
        return findMedian(arr, left, right);
    }

    int medianCount = 0;

    /* Divide into groups of 5 */
    for (int i = left; i <= right; i += 5) {
        int groupRight = i + 4;

        if (groupRight > right)
            groupRight = right;

        int medianIndex = findMedian(arr, i, groupRight);

        swap(&arr[left + medianCount], &arr[medianIndex]);

        medianCount++;
    }

    /* Recursively find median of medians */
    return medianOfMedians(
        arr,
        left,
        left + medianCount - 1
    );
}

/* Select k-th smallest element */
int selectKth(int arr[], int left, int right, int k) {
    if (left == right)
        return arr[left];

    /* Find a good pivot using Median of Medians */
    int pivotIndex = medianOfMedians(arr, left, right);

    /* Partition around pivot */
    pivotIndex = partition(arr, left, right, pivotIndex);

    int rank = pivotIndex - left + 1;

    if (k == rank)
        return arr[pivotIndex];

    if (k < rank)
        return selectKth(arr, left, pivotIndex - 1, k);

    return selectKth(
        arr,
        pivotIndex + 1,
        right,
        k - rank
    );
}

int main() {

    /* Test Case 1 */
    int arr1[] = {12, 3, 5, 7, 19};
    int n1 = 5;
    int k1 = 2;

    printf("Test Case 1:\n");
    printf("Array: 12, 3, 5, 7, 19\n");
    printf("k = %d\n", k1);
    printf("K-th smallest element = %d\n\n",
           selectKth(arr1, 0, n1 - 1, k1));


    /* Test Case 2 */
    int arr2[] = {12, 3, 5, 7, 4, 19, 26};
    int n2 = 7;
