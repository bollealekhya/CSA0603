#include <stdio.h>

// Sort weights in descending order
void sortDescending(int weights[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (weights[i] < weights[j])
            {
                temp = weights[i];
                weights[i] = weights[j];
                weights[j] = temp;
            }
        }
    }
}

// Greedy approach
int maximumWeight(int weights[], int n, int capacity)
{
    int total = 0;

    sortDescending(weights, n);

    for (int i = 0; i < n; i++)
    {
        if (total + weights[i] <= capacity)
        {
            total += weights[i];
        }
    }

    return total;
}

int main()
{
    // Test Case 1
    int weights1[] = {10, 20, 30, 40, 50};
    int n1 = 5;
    int capacity1 = 60;

    printf("Test Case 1:\n");
    printf("Maximum weight = %d\n",
           maximumWeight(weights1, n1, capacity1));

    // Test Case 2
    int weights2[] = {5, 10, 15, 20, 25, 30};
    int n2 = 6;
    int capacity2 = 50;

    printf("\nTest Case 2:\n");
    printf("Maximum weight = %d\n",
           maximumWeight(weights2, n2, capacity2));

    return 0;
}
