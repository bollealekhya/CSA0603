#include <stdio.h>

void selectionSort(int arr[], int n) {
    int i, j, minIndex, temp;

    for (i = 0; i < n - 1; i++) {
        minIndex = i;

        for (j = i + 1; j < n; j++) {
            if (arr[j] < arr[minIndex]) {
                minIndex = j;
            }
        }

        // Swap
        temp = arr[i];
        arr[i] = arr[minIndex];
        arr[minIndex] = temp;
    }
}

void printArray(int arr[], int n) {
    printf("[");

    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);

        if (i < n - 1)
            printf(", ");
    }

    printf("]\n");
}

int main() {
    int choice;
    int arr[100];
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n > 0) {
        printf("Enter the elements: ");

        for (int i = 0; i < n; i++) {
            scanf("%d", &arr[i]);
        }
    }

    selectionSort(arr, n);

    printf("Sorted list: ");
    printArray(arr, n);

    return 0;
}
