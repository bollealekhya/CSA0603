#include <stdio.h>
#include <string.h>

#define MAX_WORDS 100
#define MAX_LEN 100

// Check whether 'small' is a substring of 'large'
int isSubstring(char large[], char small[]) {
    int n = strlen(large);
    int m = strlen(small);

    if (m > n)
        return 0;

    for (int i = 0; i <= n - m; i++) {
        int j;

        for (j = 0; j < m; j++) {
            if (large[i + j] != small[j])
                break;
        }

        if (j == m)
            return 1;
    }

    return 0;
}

int main() {
    int n;
    char words[MAX_WORDS][MAX_LEN];

    printf("Enter number of words: ");
    scanf("%d", &n);

    printf("Enter the words:\n");
    for (int i = 0; i < n; i++) {
        scanf("%s", words[i]);
    }

    printf("Output: [");

    int first = 1;

    for (int i = 0; i < n; i++) {
        int found = 0;

        // Compare words[i] with every other word
        for (int j = 0; j < n; j++) {
            if (i != j && isSubstring(words[j], words[i])) {
                found = 1;
                break;
            }
        }

        if (found) {
            if (!first)
                printf(", ");

            printf("\"%s\"", words[i]);
            first = 0;
        }
    }

    printf("]\n");

    return 0;
}
