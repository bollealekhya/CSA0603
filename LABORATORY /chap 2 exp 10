#include <stdio.h>
#include <math.h>
#include <float.h>

typedef struct {
    double x, y;
} Point;

/* Calculate Euclidean distance */
double distance(Point p1, Point p2) {
    double dx = p1.x - p2.x;
    double dy = p1.y - p2.y;

    return sqrt(dx * dx + dy * dy);
}

/* Find closest pair using brute force */
void closestPair(Point points[], int n) {
    double minDist = DBL_MAX;
    int p1 = 0, p2 = 1;

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {

            double d = distance(points[i], points[j]);

            if (d < minDist) {
                minDist = d;
                p1 = i;
                p2 = j;
            }
        }
    }

    printf("\nClosest Pair:\n");
    printf("(%.2f, %.2f) and (%.2f, %.2f)\n",
           points[p1].x, points[p1].y,
           points[p2].x, points[p2].y);

    printf("Minimum Distance = %.6f\n", minDist);
}

int main() {

    Point points[] = {
        {1, 2},
        {4, 5},
        {7, 8},
        {3, 1}
    };

    int n = sizeof(points) / sizeof(points[0]);

    closestPair(points, n);

    return 0;
}
