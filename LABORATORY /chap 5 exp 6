#include <stdio.h>

#define INF 999999
#define MAXV 20
#define MAXE 50

typedef struct
{
    int u;
    int v;
    int w;
} Edge;

/* Dijkstra's Algorithm */
int dijkstra(Edge edges[], int n, int m, int source, int target)
{
    int dist[MAXV];
    int visited[MAXV];

    /* Initialize */
    for (int i = 0; i < n; i++)
    {
        dist[i] = INF;
        visited[i] = 0;
    }

    dist[source] = 0;

    for (int count = 0; count < n; count++)
    {
        int u = -1;
        int minDist = INF;

        /* Find unvisited vertex with minimum distance */
        for (int i = 0; i < n; i++)
        {
            if (!visited[i] && dist[i] < minDist)
            {
                minDist = dist[i];
                u = i;
            }
        }

        if (u == -1)
            break;

        visited[u] = 1;

        /*
         * Relax all edges starting from u
         */
        for (int i = 0; i < m; i++)
        {
            if (edges[i].u == u)
            {
                int v = edges[i].v;
                int w = edges[i].w;

                if (!visited[v] &&
                    dist[u] + w < dist[v])
                {
                    dist[v] = dist[u] + w;
                }
            }
        }
    }

    return dist[target];
}

