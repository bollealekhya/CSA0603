#include <stdio.h>
#include <stdlib.h>

/* Compare function for qsort */
int compare(const void *a, const void *b)
{
    return (*(int *)a - *(int *)b);
}

/* Find minimum number of coins to add */
int minCoinsToAdd(int coins[], int n, int target)
{
    /* Sort the coins */
    qsort(coins, n, sizeof(int), compare);

    long long reachable = 0;
    int i = 0;
    int added = 0;

    while (reachable < target)
    {
        /*
           If the current coin can extend the
           reachable range, use it.
        */
        if (i < n && coins[i] <= reachable + 1)
        {
            reachable += coins[i];
            i++;
        }
        else
        {
            /*
               reachable + 1 cannot currently be formed.
               Add a coin of this value.
            */
            reachable += reachable + 1;
            added++;
        }
    }

    return added;
}

int main()
{
    /* Test Case 1 */
    int coins1[] = {1, 4, 10};
    int n1 = 3;
    int target1 = 19;

    printf("Test Case 1:\n");
    printf("Input: [1, 4, 10], Target = 19\n");

    int result1 = minCoinsToAdd(coins1, n1, target1);

    printf("Minimum coins to add = %d\n", result1);


    /* Test Case 2 */
    int coins2[] = {1, 4, 10, 5, 7, 19};
    int n2 = 6;
    int target2 = 19;

    printf("\nTest Case 2:\n");
    printf("Input: [1, 4, 10, 5, 7, 19], Target = 19\n");

    int result2 = minCoinsToAdd(coins2, n2, target2);

    printf("Minimum coins to add = %d\n", result2);

    return 0;
}
