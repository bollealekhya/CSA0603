#include <stdio.h>

int findKthMissing(int arr[], int n, int k) {
    int missing = 0;
    int current = 1;
    int i = 0;

    while (missing < k) {
        if (i < n && arr[i] == current) {
            // Number exists in the array
            i++;
        } else {
            // Number is missing
            missing++;
            
            if (missing == k)
                return current;
        }

        current++;
    }

    return current;
}

int main() {
    int n, k;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter the sorted array: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter k: ");
    scanf("%d", &k);

    int result = findKthMissing(arr, n, k);

    printf("The %dth missing positive integer is: %d\n", k, result);

    return 0;
}
