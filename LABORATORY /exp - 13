#include <stdio.h>

int climbStairs(int n) {
    if (n <= 2)
        return n;

    int a = 1;  // ways to reach step 0
    int b = 2;  // ways to reach step 1

    for (int i = 3; i <= n; i++) {
        int c = a + b;
        a = b;
        b = c;
    }

    return b;
}

int main() {
    int n;

    printf("Enter number of steps: ");
    scanf("%d", &n);

    printf("Number of distinct ways: %d\n", climbStairs(n));

    return 0;
}
