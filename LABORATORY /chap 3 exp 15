#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

/* Compare function for qsort */
int compare(const void *a, const void *b) {
    return (*(long long *)a - *(long long *)b);
}

/* Generate all subset sums */
void generateSums(int arr[], int n, long long sums[]) {
    int total = 1 << n;

    for (int mask = 0; mask < total; mask++) {
        long long sum = 0;

        for (int i = 0; i < n; i++) {
            if (mask & (1 << i))
                sum += arr[i];
        }

        sums[mask] = sum;
    }
}

/* Binary search for target */
bool binarySearch(long long arr[], int n, long long target) {
    int low = 0;
    int high = n - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == target)
            return true;
        else if (arr[mid] < target)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return false;
}

/* Meet in the Middle */
bool subsetSumMITM(int arr[], int n, int target) {

    int n1 = n / 2;
    int n2 = n - n1;

    int size1 = 1 << n1;
    int size2 = 1 << n2;

    long long *leftSums =
        malloc(size1 * sizeof(long long));

    long long *rightSums =
        malloc(size2 * sizeof(long long));

    generateSums(arr, n1, leftSums);

    generateSums(arr + n1, n2, rightSums);

    /* Sort the right half */
    qsort(rightSums, size2, sizeof(long long), compare);

    /* Check every left sum */
    for (int i = 0; i < size1; i++) {

        long long required = target - leftSums[i];

        if (binarySearch(rightSums, size2, required)) {
            free(leftSums);
            free(rightSums);
            return true;
        }
    }

    free(leftSums);
    free(rightSums);

    return false;
}

int main() {

    /* Test Case 1 */
    int arr1[] = {1, 3, 9, 2, 7, 12};
    int n1 = 6;
    int target1 = 15;

    bool result1 = subsetSumMITM(arr1, n1, target1);

    printf("Test Case 1:\n");
    printf("Array: {1, 3, 9, 2, 7, 12}\n");
    printf("Exact Sum = %d\n", target1);
    printf("Result: %s\n\n",
           result1 ? "true" : "false");


    /* Test Case 2 */
    int arr2[] = {3, 34, 4, 12, 5, 2};
    int n2 = 6;
    int target2 = 15;

    bool result2 = subsetSumMITM(arr2, n2, target2);

    printf("Test Case 2:\n");
    printf("Array: {3, 34, 4, 12, 5, 2}\n");
    printf("Exact Sum = %d\n", target2);
    printf("Result: %s\n",
           result2 ? "true" : "false");

    return 0;
}
