#include <stdio.h>

typedef struct {
    int x;
    int y;
    int distance;
} Point;

void findKClosest(Point points[], int n, int k) {
    // Calculate squared distance from origin
    for (int i = 0; i < n; i++) {
        points[i].distance =
            points[i].x * points[i].x +
            points[i].y * points[i].y;
    }

    // Sort points by distance using Selection Sort
    for (int i = 0; i < n - 1; i++) {
        int minIndex = i;

        for (int j = i + 1; j < n; j++) {
            if (points[j].distance < points[minIndex].distance) {
                minIndex = j;
            }
        }

        // Swap
        Point temp = points[i];
        points[i] = points[minIndex];
        points[minIndex] = temp;
    }

    // Print k closest points
    printf("K closest points: [");

    for (int i = 0; i < k; i++) {
        printf("[%d, %d]", points[i].x, points[i].y);

        if (i < k - 1)
            printf(", ");
    }

    printf("]\n");
}

int main() {
    int n, k;

    printf("Enter number of points: ");
    scanf("%d", &n);

    Point points[n];

    printf("Enter the points (x y):\n");

    for (int i = 0; i < n; i++) {
        scanf("%d %d", &points[i].x, &points[i].y);
    }

    printf("Enter k: ");
    scanf("%d", &k);

    findKClosest(points, n, k);

    return 0;
}
