#include <stdio.h>

void printArray(int a[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d", a[i]);
        if (i < n - 1)
            printf(", ");
    }
    printf("\n");
}

/* Partition using the first element as pivot */
int partition(int a[], int low, int high) {
    int pivot = a[low];
    int i = low + 1;
    int j = high;
    int temp;

    while (i <= j) {

        while (i <= high && a[i] <= pivot)
            i++;

        while (j >= low && a[j] > pivot)
            j--;

        if (i < j) {
            temp = a[i];
            a[i] = a[j];
            a[j] = temp;
        }
    }

    /* Put pivot in its correct position */
    temp = a[low];
    a[low] = a[j];
    a[j] = temp;

    return j;
}

/* Quick Sort */
void quickSort(int a[], int low, int high, int n) {
    if (low < high) {

        int pivotIndex = partition(a, low, high);

        printf("After partition (pivot = %d): ", a[pivotIndex]);
        printArray(a, n);

        quickSort(a, low, pivotIndex - 1, n);
        quickSort(a, pivotIndex + 1, high, n);
    }
}

int main() {
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int a[n];

    printf("Enter the elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("\nOriginal Array: ");
    printArray(a, n);

    printf("\nQuick Sort Steps:\n");

    quickSort(a, 0, n - 1, n);

    printf("\nFinal Sorted Array: ");
    printArray(a, n);

    return 0;
}
