#include <stdio.h>
#include <string.h>

#define MAX_WORDS 100
#define MAX_LEN 100

void justifyText(char words[][MAX_LEN], int n, int maxWidth) {
    int i = 0;

    while (i < n) {
        int j = i;
        int lineLength = 0;

        /*
         * Greedily select as many words as possible
         * for the current line.
         */
        while (j < n) {
            int wordLen = strlen(words[j]);

            if (lineLength + wordLen + (j - i) > maxWidth)
                break;

            lineLength += wordLen;
            j++;
        }

        int wordCount = j - i;
        int totalSpaces = maxWidth - lineLength;

        /* Last line or line with only one word */
        if (j == n || wordCount == 1) {

            for (int k = i; k < j; k++) {
                printf("%s", words[k]);

                if (k < j - 1)
                    printf(" ");
            }

            /* Add spaces at the end */
            int usedLength = lineLength + wordCount - 1;

            for (int k = usedLength; k < maxWidth; k++)
                printf(" ");

        } else {

            /* Fully justify the line */
            int gaps = wordCount - 1;

            int spacesPerGap = totalSpaces / gaps;
            int extraSpaces = totalSpaces % gaps;

            for (int k = i; k < j; k++) {

                printf("%s", words[k]);

                if (k < j - 1) {

                    int spaces = spacesPerGap;

                    /*
                     * Left gaps receive extra spaces
                     */
                    if (k - i < extraSpaces)
                        spaces++;

                    for (int s = 0; s < spaces; s++)
                        printf(" ");
                }
            }
        }

        printf("\n");

        i = j;
    }
}

int main() {

    /* Test Case 1 */
    char words1[][MAX_LEN] = {
        "This", "is", "an", "example",
        "of", "text", "justification."
    };

    int n1 = 7;
    int maxWidth1 = 16;

    printf("Test Case 1:\n");

    justifyText(words1, n1, maxWidth1);


    /* Test Case 2 */
    char words2[][MAX_LEN] = {
        "What", "must", "be",
        "acknowledgment", "shall", "be"
    };

    int n2 = 6;
    int maxWidth2 = 16;

    printf("\nTest Case 2:\n");

    justifyText(words2, n2, maxWidth2);

    return 0;
}
