#include <stdio.h>
#include <limits.h>

#define MAX 10

int n;
int cost[MAX][MAX];
int visited[MAX];
int minCost;

/* Find minimum TSP path using backtracking */
void tsp(int current, int count, int totalCost) {

    /* All cities visited */
    if (count == n) {
        /* Return to starting city */
        totalCost += cost[current][0];

        if (totalCost < minCost)
            minCost = totalCost;

        return;
    }

    /* Try every unvisited city */
    for (int i = 0; i < n; i++) {

        if (!visited[i]) {

            visited[i] = 1;

            tsp(i, count + 1,
                totalCost + cost[current][i]);

            visited[i] = 0;
        }
    }
}

int main() {

    /* Test Case 1 */
    int matrix1[4][4] = {
        {0, 10, 15, 20},
        {10, 0, 35, 25},
        {15, 35, 0, 30},
        {20, 25, 30, 0}
    };

    n = 4;

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cost[i][j] = matrix1[i][j];

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    minCost = INT_MAX;

    visited[0] = 1;

    tsp(0, 1, 0);

    printf("Test Case 1:\n");
    printf("Minimum Path Distance = %d\n\n", minCost);


    /* Test Case 2 */
    int matrix2[4][4] = {
        {0, 10, 10, 10},
        {10, 0, 10, 10},
        {10, 10, 0, 10},
        {10, 10, 10, 0}
    };

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cost[i][j] = matrix2[i][j];

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    minCost = INT_MAX;

    visited[0] = 1;

    tsp(0, 1, 0);

    printf("Test Case 2:\n");
    printf("Minimum Path Distance = %d\n\n", minCost);


    /* Test Case 3 */
    int matrix3[4][4] = {
        {0, 1, 2, 3},
        {1, 0, 4, 5},
        {2, 4, 0, 6},
        {3, 5, 6, 0}
    };

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cost[i][j] = matrix3[i][j];

    for (int i = 0; i < n; i++)
        visited[i] = 0;

    minCost = INT_MAX;

    visited[0] = 1;

    tsp(0, 1, 0);

    printf("Test Case 3:\n");
    printf("Minimum Path Distance = %d\n", minCost);

    return 0;
}
