#include <stdio.h>

#define MAX 100
#define INF 999999

int networkDelayTime(int times[][3], int edgeCount, int n, int k)
{
    int graph[MAX][MAX];
    int dist[MAX];
    int visited[MAX] = {0};

    // Initialize graph
    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= n; j++)
        {
            graph[i][j] = INF;
        }
    }

    // Directed edges
    for (int i = 0; i < edgeCount; i++)
    {
        int u = times[i][0];
        int v = times[i][1];
        int w = times[i][2];

        graph[u][v] = w;
    }

    // Initialize distances
    for (int i = 1; i <= n; i++)
    {
        dist[i] = INF;
    }

    dist[k] = 0;

    // Dijkstra's algorithm
    for (int count = 1; count <= n; count++)
    {
        int u = -1;
        int minDist = INF;

        // Find unvisited node with minimum distance
        for (int i = 1; i <= n; i++)
        {
            if (!visited[i] && dist[i] < minDist)
            {
                minDist = dist[i];
                u = i;
            }
        }

        // No more reachable nodes
        if (u == -1)
            break;

        visited[u] = 1;

        // Relax edges
        for (int v = 1; v <= n; v++)
        {
            if (!visited[v] &&
                graph[u][v] != INF &&
                dist[u] + graph[u][v] < dist[v])
            {
                dist[v] = dist[u] + graph[u][v];
            }
        }
    }

    // Find maximum shortest distance
    int answer = 0;

    for (int i = 1; i <= n; i++)
    {
        if (dist[i] == INF)
        {
            return -1;
        }

        if (dist[i] > answer)
        {
            answer = dist[i];
        }
    }

    return answer;
}

int main()
{
    // Test Case 1
    int times1[][3] = {
        {2, 1, 1},
        {2, 3, 1},
        {3, 4, 1}
    };

    int n1 = 4;
    int k1 = 2;

    printf("Test Case 1:\n");
    printf("Output: %d\n",
           networkDelayTime(times1, 3, n1, k1));


    // Test Case 2
    int times2[][3] = {
        {1, 2, 1}
    };

    int n2 = 2;
    int k2 = 1;

    printf("\nTest Case 2:\n");
    printf("Output: %d\n",
           networkDelayTime(times2, 1, n2, k2));


    // Test Case 3
    int times3[][3] = {
        {1, 2, 1}
    };

    int n3 = 2;
    int k3 = 2;

    printf("\nTest Case 3:\n");
    printf("Output: %d\n",
           networkDelayTime(times3, 1, n3, k3));

    return 0;
}
