#include <stdio.h>

int countGoodPairs(int nums[], int n)
{
    int count = 0;

    for (int i = 0; i < n; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (nums[i] == nums[j])
            {
                count++;
            }
        }
    }

    return count;
}

int main()
{
    // Test Case 1
    int nums1[] = {1, 2, 3, 1, 1, 3};
    int n1 = 6;

    printf("Test Case 1:\n");
    printf("Input: [1, 2, 3, 1, 1, 3]\n");
    printf("Number of Good Pairs: %d\n",
           countGoodPairs(nums1, n1));

    // Test Case 2
    int nums2[] = {1, 1, 1, 1};
    int n2 = 4;

    printf("\nTest Case 2:\n");
    printf("Input: [1, 1, 1, 1]\n");
    printf("Number of Good Pairs: %d\n",
           countGoodPairs(nums2, n2));

    return 0;
}
