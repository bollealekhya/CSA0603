import itertools

# Calculate total cost for an assignment
def total_cost(assignment, cost_matrix):
    total = 0

    for worker, task in enumerate(assignment):
        total += cost_matrix[worker][task]

    return total


# Exhaustive Search Assignment Problem
def assignment_problem(cost_matrix):
    n = len(cost_matrix)

    min_cost = float('inf')
    best_assignment = None

    # Generate all possible task assignments
    for assignment in itertools.permutations(range(n)):

        cost = total_cost(assignment, cost_matrix)

        if cost < min_cost:
            min_cost = cost
            best_assignment = assignment

    return best_assignment, min_cost


# Print assignment
def print_result(assignment, cost):
    print("Optimal Assignment:", end=" ")

    pairs = []

    for worker, task in enumerate(assignment):
        pairs.append(
            f"(worker {worker + 1}, task {task + 1})"
        )

    print("[" + ", ".join(pairs) + "]")
    print("Total Cost:", cost)


# Test Case 1
cost_matrix1 = [
    [3, 10, 7],
    [8, 5, 12],
    [4, 6, 9]
]

assignment1, cost1 = assignment_problem(cost_matrix1)

print("Test Case 1:")
print_result(assignment1, cost1)


# Test Case 2
cost_matrix2 = [
    [15, 9, 4],
    [8, 7, 18],
    [6, 12, 11]
]

assignment2, cost2 = assignment_problem(cost_matrix2)

print("\nTest Case 2:")
print_result(assignment2, cost2)
