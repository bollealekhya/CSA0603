#include <stdio.h>

#define MAX 100

double champagneTower(int poured, int query_row, int query_glass) {
    double dp[MAX + 1][MAX + 1] = {0};

    // Pour champagne into the top glass
    dp[0][0] = poured;

    for (int i = 0; i < query_row; i++) {
        for (int j = 0; j <= i; j++) {

            // Excess champagne
            double excess = (dp[i][j] - 1.0) / 2.0;

            if (excess > 0) {
                dp[i + 1][j] += excess;
                dp[i + 1][j + 1] += excess;
            }
        }
    }

    // A glass can hold at most 1 cup
    if (dp[query_row][query_glass] > 1.0)
        return 1.0;

    return dp[query_row][query_glass];
}

int main() {
    int poured, query_row, query_glass;

    printf("Enter poured cups: ");
    scanf("%d", &poured);

    printf("Enter query row: ");
    scanf("%d", &query_row);

    printf("Enter query glass: ");
    scanf("%d", &query_glass);

    double result = champagneTower(
        poured,
        query_row,
        query_glass
    );

    printf("Glass fullness: %.5f\n", result);

    return 0;
}
