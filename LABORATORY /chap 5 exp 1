#include <stdio.h>

/* Swap two elements */
void swap(int *a, int *b)
{
    int temp = *a;
    *a = *b;
    *b = temp;
}

/* Selection Sort */
void sort(int piles[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        int minIndex = i;

        for (int j = i + 1; j < n; j++)
        {
            if (piles[j] < piles[minIndex])
                minIndex = j;
        }

        swap(&piles[i], &piles[minIndex]);
    }
}

/* Find maximum coins for you */
int maxCoins(int piles[], int n)
{
    sort(piles, n);

    int yourCoins = 0;

    /*
       Bob takes the smallest pile.
       You take the second largest available pile.
       Alice takes the largest.
    */

    int left = 0;
    int right = n - 1;

    while (left < right)
    {
        /* Alice gets the largest */
        right--;

        /* You get the next largest */
        yourCoins += piles[right];

        /* Bob gets the smallest */
        left++;
    }

    return yourCoins;
}

int main()
{
    /* Test Case 1 */
    int piles1[] = {2, 4, 1, 2, 7, 8};
    int n1 = 6;

    printf("Test Case 1:\n");
    printf("Input: [2, 4, 1, 2, 7, 8]\n");

    int result1 = maxCoins(piles1, n1);

    printf("Maximum coins = %d\n", result1);


    /* Test Case 2 */
    int piles2[] = {2, 4, 5};
    int n2 = 3;

    printf("\nTest Case 2:\n");
    printf("Input: [2, 4, 5]\n");

    int result2 = maxCoins(piles2, n2);

    printf("Maximum coins = %d\n", result2);

    return 0;
}
