#include <iostream>
#include <vector>
using namespace std;

long long countPairs(vector<int>& nums, int k) {
    long long count = 0;
    int n = nums.size();

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {

            // Check if values are equal
            // and i*j is divisible by k
            if (nums[i] == nums[j] && (i * j) % k == 0) {
                count++;
            }
        }
    }

    return count;
}

int main() {
    vector<int> nums1 = {3, 1, 2, 2, 2, 1, 3};
    int k1 = 2;

    vector<int> nums2 = {1, 2, 3, 4};
    int k2 = 1;

    cout << "Output 1: " << countPairs(nums1, k1) << endl;
    cout << "Output 2: " << countPairs(nums2, k2) << endl;

    return 0;
}
