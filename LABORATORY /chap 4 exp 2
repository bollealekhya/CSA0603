#include <stdio.h>

#define INF 999999

int min3(int a, int b, int c) {
    if (a <= b && a <= c)
        return a;
    else if (b <= a && b <= c)
        return b;
    else
        return c;
}

int main() {
    int n;

    printf("Enter number of stations: ");
    scanf("%d", &n);

    int a[3][n];
    int t[3][3][n];
    int e[3], x[3];

    printf("\nEnter station processing times:\n");

    for (int line = 0; line < 3; line++) {
        printf("Line %d: ", line + 1);

        for (int i = 0; i < n; i++) {
            scanf("%d", &a[line][i]);
        }
    }

    printf("\nEnter entry times for 3 lines:\n");

    for (int i = 0; i < 3; i++) {
        printf("Entry time Line %d: ", i + 1);
        scanf("%d", &e[i]);
    }

    printf("\nEnter exit times for 3 lines:\n");

    for (int i = 0; i < 3; i++) {
        printf("Exit time Line %d: ", i + 1);
        scanf("%d", &x[i]);
    }

    /*
       t[from][to][i] =
       transfer time from 'from' line to 'to' line
       after station i
    */

    printf("\nEnter transfer times:\n");

    for (int from = 0; from < 3; from++) {
        for (int to = 0; to < 3; to++) {

            if (from == to)
                continue;

            printf("Transfer Line %d -> Line %d:\n",
                   from + 1, to + 1);

            for (int i = 0; i < n - 1; i++) {
                printf("  After station %d: ", i + 1);
                scanf("%d", &t[from][to][i]);
            }
        }
    }

    /* DP array */
    int dp[3][n];

    /* First station */
    for (int line = 0; line < 3; line++) {
        dp[line][0] = e[line] + a[line][0];
    }

    /* Remaining stations */
    for (int i = 1; i < n; i++) {

        for (int line = 0; line < 3; line++) {

            int best = INF;

            for (int prev = 0; prev < 3; prev++) {

                int time;

                if (prev == line) {
                    time = dp[prev][i - 1];
                } else {
                    time = dp[prev][i - 1]
                         + t[prev][line][i - 1];
                }

                if (time < best)
                    best = time;
            }

            dp[line][i] = best + a[line][i];
        }
    }

    /* Add exit times */
    int answer = INF;

    for (int line = 0; line < 3; line++) {
        int total = dp[line][n - 1] + x[line];

        if (total < answer)
            answer = total;
    }

    printf("\nMinimum processing time = %d\n", answer);

    return 0;
}
