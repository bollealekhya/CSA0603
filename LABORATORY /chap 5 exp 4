#include <stdio.h>
#include <stdlib.h>

typedef struct
{
    int start;
    int end;
    int profit;
} Job;

/* Compare jobs according to ending time */
int compare(const void *a, const void *b)
{
    Job *job1 = (Job *)a;
    Job *job2 = (Job *)b;

    return job1->end - job2->end;
}

/* Find the last job that finishes
   before or exactly when current job starts */
int findPreviousJob(Job jobs[], int index)
{
    int low = 0;
    int high = index - 1;
    int answer = -1;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        if (jobs[mid].end <= jobs[index].start)
        {
            answer = mid;
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    return answer;
}

/* Weighted Job Scheduling */
int maxProfit(int startTime[], int endTime[],
              int profit[], int n)
{
    Job jobs[n];

    /* Create job objects */
    for (int i = 0; i < n; i++)
    {
        jobs[i].start = startTime[i];
        jobs[i].end = endTime[i];
        jobs[i].profit = profit[i];
    }

    /* Sort jobs by end time */
    qsort(jobs, n, sizeof(Job), compare);

    /* dp[i] = maximum profit using jobs 0...i */
    int dp[n];

    dp[0] = jobs[0].profit;

    for (int i = 1; i < n; i++)
    {
        /* Profit if we take current job */
        int includeProfit = jobs[i].profit;

        int previous = findPreviousJob(jobs, i);

        if (previous != -1)
            includeProfit += dp[previous];

        /* Profit if we skip current job */
        int excludeProfit = dp[i - 1];

        if (includeProfit > excludeProfit)
            dp[i] = includeProfit;
        else
            dp[i] = excludeProfit;
    }

    return dp[n - 1];
}

int main()
{
    /* ---------------- Test Case 1 ---------------- */

    int startTime1[] = {1, 2, 3, 3};
    int endTime1[] = {3, 4, 5, 6};
    int profit1[] = {50, 10, 40, 70};

    int n1 = 4;

    printf("Test Case 1:\n");

    int result1 = maxProfit(startTime1, endTime1,
                            profit1, n1);

    printf("Maximum Profit = %d\n", result1);


    /* ---------------- Test Case 2 ---------------- */

    int startTime2[] = {1, 2, 3, 4, 6};
    int endTime2[] = {3, 5, 10, 6, 9};
    int profit2[] = {20, 20, 100, 70, 60};

    int n2 = 5;

    printf("\nTest Case 2:\n");

    int result2 = maxProfit(startTime2, endTime2,
                            profit2, n2);

    printf("Maximum Profit = %d\n", result2);

    return 0;
}
