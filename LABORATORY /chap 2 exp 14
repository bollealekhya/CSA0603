from itertools import combinations

# Calculate total value of selected items
def total_value(items, values):
    total = 0

    for item in items:
        total += values[item]

    return total


# Check whether selected items fit within the capacity
def is_feasible(items, weights, capacity):
    total_weight = 0

    for item in items:
        total_weight += weights[item]

    return total_weight <= capacity


# Exhaustive search for 0-1 Knapsack
def knapsack(weights, values, capacity):
    n = len(weights)

    best_items = []
    best_value = 0

    # Generate all possible subsets
    for r in range(n + 1):
        for items in combinations(range(n), r):

            # Check if the subset is feasible
            if is_feasible(items, weights, capacity):

                value = total_value(items, values)

                # Update best solution
                if value > best_value:
                    best_value = value
                    best_items = list(items)

    return best_items, best_value


# ---------------- TEST CASE 1 ----------------

weights1 = [2, 3, 1]
values1 = [4, 5, 3]
capacity1 = 4

items1, value1 = knapsack(weights1, values1, capacity1)

print("Test Case 1:")
