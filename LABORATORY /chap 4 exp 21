#include <stdio.h>

#define INF 999999

void findCity(int n, int edges[][3], int edgeCount, int threshold)
{
    int dist[n][n];

    // Initialize distance matrix
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (i == j)
                dist[i][j] = 0;
            else
                dist[i][j] = INF;
        }
    }

    // Add edges
    for (int i = 0; i < edgeCount; i++)
    {
        int u = edges[i][0];
        int v = edges[i][1];
        int w = edges[i][2];

        dist[u][v] = w;
        dist[v][u] = w;
    }

    // Floyd-Warshall Algorithm
    for (int k = 0; k < n; k++)
    {
        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < n; j++)
            {
                if (dist[i][k] != INF &&
                    dist[k][j] != INF &&
                    dist[i][j] > dist[i][k] + dist[k][j])
                {
                    dist[i][j] =
                        dist[i][k] + dist[k][j];
                }
            }
        }
    }

    // Find city with minimum reachable cities
    int bestCity = -1;
    int minimumCount = INF;

    for (int i = 0; i < n; i++)
    {
        int count = 0;

        for (int j = 0; j < n; j++)
        {
            if (i != j && dist[i][j] <= threshold)
            {
                count++;
            }
        }

        printf("City %d -> %d reachable cities\n", i, count);

        /*
           If count is smaller, update.
           If count is equal, choose the city
           with the greater index.
        */
        if (count <= minimumCount)
        {
            minimumCount = count;
            bestCity = i;
        }
    }

    printf("City with smallest number of reachable cities: %d\n",
           bestCity);
}

int main()
{
    /* ================= TEST CASE 1 ================= */

    int n1 = 4;

    int edges1[][3] = {
        {0, 1, 3},
        {1, 2, 1},
        {1, 3, 4},
        {2, 3, 1}
    };

    int threshold1 = 4;

    printf("========== TEST CASE 1 ==========\n");

    findCity(n1, edges1, 4, threshold1);


    /* ================= TEST CASE 2 ================= */

    int n2 = 5;

    int edges2[][3] = {
