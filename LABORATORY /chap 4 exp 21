        {0, 4, 8},
        {1, 2, 3},
        {1, 4, 2},
        {2, 3, 1},
        {3, 4, 1}
    };

    int threshold2 = 2;

    printf("\n========== TEST CASE 2 ==========\n");

    findCity(n2, edges2, 6, threshold2);

    return 0;
}
