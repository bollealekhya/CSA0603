#include <stdio.h>

#define MAX 20

int jobs[MAX];
int n, k;
int workerTime[MAX];

/* Check whether jobs can be assigned
   with maximum working time = limit */
int canAssign(int index, int limit)
{
    /* All jobs have been assigned */
    if (index == n)
        return 1;

    int job = jobs[index];

    for (int i = 0; i < k; i++)
    {
        /* Assign job to worker i */
        if (workerTime[i] + job <= limit)
        {
            workerTime[i] += job;

            if (canAssign(index + 1, limit))
                return 1;

            workerTime[i] -= job;
        }

        /*
           If this worker has no jobs and the current
           job cannot fit, other empty workers will
           behave identically.
        */
        if (workerTime[i] == 0)
            break;
    }

    return 0;
}

/* Sort jobs in descending order */
void sortDescending()
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (jobs[i] < jobs[j])
            {
                int temp = jobs[i];
                jobs[i] = jobs[j];
                jobs[j] = temp;
            }
        }
    }
}

/* Find minimum possible maximum working time */
int minimumTime(int inputJobs[], int size, int workers)
{
    n = size;
    k = workers;

    int low = 0;
    int high = 0;

    for (int i = 0; i < n; i++)
    {
        jobs[i] = inputJobs[i];

        if (jobs[i] > low)
            low = jobs[i];

        high += jobs[i];
    }

    /*
       Larger jobs are assigned first.
       This makes backtracking faster.
    */
    sortDescending();

    int answer = high;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        for (int i = 0; i < k; i++)
            workerTime[i] = 0;

        if (canAssign(0, mid))
        {
            answer = mid;
            high = mid - 1;
        }
        else
        {
            low = mid + 1;
        }
    }

    return answer;
}

int main()
{
    /* Test Case 1 */
    int jobs1[] = {3, 2, 3};
    int k1 = 3;

    printf("Test Case 1:\n");
    printf("Jobs: [3, 2, 3]\n");
    printf("Workers: %d\n", k1);

    int result1 = minimumTime(jobs1, 3, k1);

    printf("Minimum maximum working time = %d\n",
           result1);


    /* Test Case 2 */
    int jobs2[] = {1, 2, 4, 7, 8};
    int k2 = 2;

    printf("\nTest Case 2:\n");
    printf("Jobs: [1, 2, 4, 7, 8]\n");
    printf("Workers: %d\n", k2);

    int result2 = minimumTime(jobs2, 5, k2);

    printf("Minimum maximum working time = %d\n",
           result2);

    return 0;
}
