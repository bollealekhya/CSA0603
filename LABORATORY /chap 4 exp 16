#include <stdio.h>
#include <limits.h>

#define MAX 20

void optimalBST(int keys[], int freq[], int n)
{
    int cost[MAX][MAX] = {0};
    int root[MAX][MAX] = {0};

    /* Cost of a single key */
    for (int i = 0; i < n; i++) {
        cost[i][i] = freq[i];
        root[i][i] = i;
    }

    /* Length of the chain */
    for (int len = 2; len <= n; len++) {

        for (int i = 0; i <= n - len; i++) {

            int j = i + len - 1;
            int sum = 0;

            for (int k = i; k <= j; k++)
                sum += freq[k];

            cost[i][j] = INT_MAX;

            /* Try every key as root */
            for (int r = i; r <= j; r++) {

                int left = (r > i) ? cost[i][r - 1] : 0;
                int right = (r < j) ? cost[r + 1][j] : 0;

                int current = left + right + sum;

                if (current < cost[i][j]) {
                    cost[i][j] = current;
                    root[i][j] = r;
                }
            }
        }
    }

    /* Cost Matrix */
    printf("\nCost Matrix:\n");

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {

            if (j < i)
                printf("%5d", 0);
            else
                printf("%5d", cost[i][j]);
        }
        printf("\n");
    }

    /* Root Matrix */
    printf("\nRoot Matrix:\n");

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {

            if (j < i)
                printf("%5d", 0);
            else
                printf("%5d", root[i][j] + 1);
        }
        printf("\n");
    }

    printf("\nMinimum OBST Cost = %d\n", cost[0][n - 1]);

    printf("Root of OBST = Key %d\n",
           keys[root[0][n - 1]]);
}

/* ---------------- MAIN ---------------- */

int main()
{
    /* Main Test Case */
    int keys[] = {10, 12, 16, 21};
    int freq[] = {4, 2, 6, 3};

    printf("========== MAIN TEST CASE ==========\n");

    optimalBST(keys, freq, 4);


    /* Test Case A */
    int keysA[] = {10, 12};
    int freqA[] = {34, 50};

    printf("\n\n========== TEST CASE A ==========\n");

    optimalBST(keysA, freqA, 2);


    /* Test Case B */
    int keysB[] = {10, 12, 20};
    int freqB[] = {34, 8, 50};

    printf("\n\n========== TEST CASE B ==========\n");

    optimalBST(keysB, freqB, 3);

    return 0;
}
