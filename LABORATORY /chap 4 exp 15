#include <stdio.h>

#define MAX 20
#define INF 999999

void optimalBST(int keys[], int freq[], int n) {
    int cost[MAX][MAX] = {0};
    int root[MAX][MAX] = {0};

    /* Cost of a single key */
    for (int i = 1; i <= n; i++) {
        cost[i][i] = freq[i - 1];
        root[i][i] = i;
    }

    /* Calculate cost for chains of increasing length */
    for (int length = 2; length <= n; length++) {

        for (int i = 1; i <= n - length + 1; i++) {

            int j = i + length - 1;
            int sum = 0;
            int minCost = INF;
            int bestRoot = -1;

            /* Calculate frequency sum */
            for (int k = i; k <= j; k++)
                sum += freq[k - 1];

            /* Try every key as root */
            for (int r = i; r <= j; r++) {

                int leftCost = (r > i) ? cost[i][r - 1] : 0;
                int rightCost = (r < j) ? cost[r + 1][j] : 0;

                int currentCost = leftCost + rightCost + sum;

                if (currentCost < minCost) {
                    minCost = currentCost;
                    bestRoot = r;
                }
            }

            cost[i][j] = minCost;
            root[i][j] = bestRoot;
        }
    }

    /* Display Cost Matrix */
    printf("\nCost Matrix:\n");

    printf("     ");
    for (int j = 1; j <= n; j++)
        printf("%6d", j);
    printf("\n");

    for (int i = 1; i <= n; i++) {
        printf("%3d  ", i);

        for (int j = i; j <= n; j++)
            printf("%6d", cost[i][j]);

        printf("\n");
    }

    /* Display Root Matrix */
    printf("\nRoot Matrix:\n");

    printf("     ");
    for (int j = 1; j <= n; j++)
        printf("%5d", j);
    printf("\n");

    for (int i = 1; i <= n; i++) {
        printf("%3d  ", i);

        for (int j = i; j <= n; j++)
            printf("%5d", root[i][j]);

        printf("\n");
    }

    printf("\nMinimum OBST Cost = %d\n", cost[1][n]);

    /* Display root */
    printf("Root of OBST = Key %d (%d)\n",
           root[1][n], keys[root[1][n] - 1]);
}

int main() {

    /* Main Test Case */
    int keys[] = {10, 20, 30, 40};
    int freq[] = {1, 2, 4, 3};
    int n = 4;

    printf("========== MAIN TEST CASE ==========\n");

    optimalBST(keys, freq, n);


    /* Test Case A */
    int keysA[] = {10, 12};
    int freqA[] = {34, 50};

    printf("\n\n========== TEST CASE A ==========\n");

    optimalBST(keysA, freqA, 2);


    /* Test Case B */
    int keysB[] = {10, 12, 20};
    int freqB[] = {34, 8, 50};

    printf("\n\n========== TEST CASE B ==========\n");

    optimalBST(keysB, freqB, 3);

    return 0;
}
