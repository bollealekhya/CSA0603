#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

typedef struct {
    int sum;
    int mask;
} Subset;

/* Generate all subset sums */
int generateSums(int arr[], int n, Subset sums[]) {
    int total = 1 << n;

    for (int mask = 0; mask < total; mask++) {
        int sum = 0;

        for (int i = 0; i < n; i++) {
            if (mask & (1 << i))
                sum += arr[i];
        }

        sums[mask].sum = sum;
        sums[mask].mask = mask;
    }

    return total;
}

/* Compare function for sorting */
int compare(const void *a, const void *b) {
    Subset *x = (Subset *)a;
    Subset *y = (Subset *)b;

    return x->sum - y->sum;
}

/* Find closest subset */
void meetInMiddle(int arr[], int n, int target) {

    int n1 = n / 2;
    int n2 = n - n1;

    int size1 = 1 << n1;
    int size2 = 1 << n2;

    Subset *left = malloc(size1 * sizeof(Subset));
    Subset *right = malloc(size2 * sizeof(Subset));

    generateSums(arr, n1, left);

    int rightArr[n2];

    for (int i = 0; i < n2; i++)
        rightArr[i] = arr[n1 + i];

    generateSums(rightArr, n2, right);

    qsort(right, size2, sizeof(Subset), compare);

    int bestSum = 0;
    int bestMask1 = 0;
    int bestMask2 = 0;
    int minDifference = INT_MAX;

    for (int i = 0; i < size1; i++) {

        int required = target - left[i].sum;

        /* Binary search */
        int low = 0;
        int high = size2 - 1;

        while (low <= high) {

            int mid = (low + high) / 2;

            if (right[mid].sum < required)
                low = mid + 1;
            else
                high = mid - 1;
        }

        /* Check closest values around insertion point */
        int candidates[2] = {low - 1, low};

        for (int c = 0; c < 2; c++) {

            int index = candidates[c];

            if (index >= 0 && index < size2) {

                int currentSum =
                    left[i].sum + right[index].sum;

                int difference = abs(target - currentSum);

                if (difference < minDifference) {
                    minDifference = difference;
                    bestSum = currentSum;
                    bestMask1 = left[i].mask;
                    bestMask2 = right[index].mask;
                }
            }
        }
    }

    printf("Target Sum: %d\n", target);
    printf("Closest Subset: [");

    int first = 1;

    for (int i = 0; i < n1; i++) {
        if (bestMask1 & (1 << i)) {
            if (!first)
                printf(", ");
            printf("%d", arr[i]);
            first = 0;
        }
    }

    for (int i = 0; i < n2; i++) {
        if (bestMask2 & (1 << i)) {
            if (!first)
                printf(", ");
            printf("%d", arr[n1 + i]);
            first = 0;
        }
    }

    printf("]\n");
    printf("Subset Sum: %d\n", bestSum);
    printf("Difference from Target: %d\n", minDifference);

    free(left);
    free(right);
}

int main() {

    /* Test Case 1 */
    int set1[] = {45, 34, 4, 12, 5, 2};

    printf("Test Case 1:\n");
    meetInMiddle(set1, 6, 42);

    printf("\n");

    /* Test Case 2 */
    int set2[] = {1, 3, 2, 7, 4, 6};

    printf("Test Case 2:\n");
    meetInMiddle(set2, 6, 10);

    return 0;
}
