#include <stdio.h>
#include <string.h>

#define MAX 100

int wordBreak(char str[], char dict[][20], int n) {
    int len = strlen(str);
    int dp[MAX + 1] = {0};

    dp[0] = 1;  // Empty string can be segmented

    for (int i = 1; i <= len; i++) {
        for (int j = 0; j < n; j++) {

            int wordLen = strlen(dict[j]);

            if (wordLen <= i && dp[i - wordLen]) {

                if (strncmp(str + i - wordLen, dict[j], wordLen) == 0) {
                    dp[i] = 1;
                    break;
                }
            }
        }
    }

    return dp[len];
}

int main() {

    char dict[][20] = {
        "i", "like", "sam", "sung", "samsung",
        "mobile", "ice", "cream", "icecream",
        "man", "go", "mango"
    };

    int n = sizeof(dict) / sizeof(dict[0]);

    char str[MAX];

    printf("Enter string: ");
    scanf("%s", str);

    if (wordBreak(str, dict, n))
        printf("Output: Yes\n");
    else
        printf("Output: No\n");

    return 0;
}
