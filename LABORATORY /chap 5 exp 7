#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 100

typedef struct Node
{
    char ch;
    int freq;
    struct Node *left;
    struct Node *right;
} Node;

/* Create a new Huffman node */
Node* createNode(char ch, int freq)
{
    Node *newNode = (Node*)malloc(sizeof(Node));

    newNode->ch = ch;
    newNode->freq = freq;
    newNode->left = NULL;
    newNode->right = NULL;

    return newNode;
}

/* Find the node with minimum frequency */
int findMin(Node *nodes[], int size)
{
    int minIndex = 0;

    for (int i = 1; i < size; i++)
    {
        if (nodes[i]->freq < nodes[minIndex]->freq)
            minIndex = i;
    }

    return minIndex;
}

/* Build Huffman Tree */
Node* buildHuffmanTree(char characters[], int frequencies[], int n)
{
    Node *nodes[MAX];
    int size = n;

    /* Create leaf nodes */
    for (int i = 0; i < n; i++)
    {
        nodes[i] = createNode(characters[i], frequencies[i]);
    }

    /* Combine two smallest nodes repeatedly */
    while (size > 1)
    {
        int min1 = findMin(nodes, size);

        Node *left = nodes[min1];

        /* Remove min1 */
        nodes[min1] = nodes[size - 1];
        size--;

        int min2 = findMin(nodes, size);

        Node *right = nodes[min2];

        /* Remove min2 */
        nodes[min2] = nodes[size - 1];
        size--;

        /* Create internal node */
        Node *parent = createNode('$',
                                  left->freq + right->freq);

        parent->left = left;
        parent->right = right;

        nodes[size] = parent;
        size++;
    }

    return nodes[0];
}

/* Generate Huffman Codes */
void generateCodes(Node *root, char code[], int depth)
{
    if (root == NULL)
        return;

    /* Leaf node */
    if (root->left == NULL && root->right == NULL)
    {
        code[depth] = '\0';

        printf("('%c', '%s')\n",
               root->ch, code);

        return;
    }

    /* Left = 0 */
    code[depth] = '0';
    generateCodes(root->left, code, depth + 1);

    /* Right = 1 */
    code[depth] = '1';
    generateCodes(root->right, code, depth + 1);
}

/* Free memory */
void freeTree(Node *root)
{
    if (root == NULL)
        return;

    freeTree(root->left);
    freeTree(root->right);

    free(root);
}

int main()
{
    /* ================= TEST CASE 1 ================= */

    char characters1[] = {'a', 'b', 'c', 'd'};
    int frequencies1[] = {5, 9, 12, 13};

    int n1 = 4;

    printf("Test Case 1:\n");
    printf("Huffman Codes:\n");

    Node *root1 = buildHuffmanTree(
        characters1,
        frequencies1,
        n1
    );

    char code[MAX];

    generateCodes(root1, code, 0);

    freeTree(root1);


    /* ================= TEST CASE 2 ================= */

    char characters2[] =
        {'f', 'e', 'd', 'c', 'b', 'a'};

    int frequencies2[] =
        {5, 9, 12, 13, 16, 45};

    int n2 = 6;

    printf("\nTest Case 2:\n");
    printf("Huffman Codes:\n");

    Node *root2 = buildHuffmanTree(
        characters2,
        frequencies2,
        n2
    );

    generateCodes(root2, code, 0);

    freeTree(root2);

    return 0;
}
