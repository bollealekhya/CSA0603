#include <stdio.h>

int binarySearch(int a[], int n, int key) {
    int low = 0, high = n - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        printf("Low = %d, High = %d, Mid = %d, Value = %d\n",
               low, high, mid, a[mid]);

        if (a[mid] == key)
            return mid;

        if (a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

int main() {
    int n, key;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int a[n];

    printf("Enter sorted array: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter search key: ");
    scanf("%d", &key);

    int index = binarySearch(a, n, key);

    if (index != -1)
        printf("Element found at position: %d\n", index + 1);
    else
        printf("Element not found\n");

    return 0;
}
