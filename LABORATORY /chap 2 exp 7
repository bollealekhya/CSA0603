#include <stdio.h>
#include <string.h>

int findFirstOccurrence(char haystack[], char needle[]) {
    int n = strlen(haystack);
    int m = strlen(needle);

    // Empty needle
    if (m == 0)
        return 0;

    // Check every possible starting position
    for (int i = 0; i <= n - m; i++) {
        int j;

        for (j = 0; j < m; j++) {
            if (haystack[i + j] != needle[j])
                break;
        }

        // All characters matched
        if (j == m)
            return i;
    }

    return -1;
}

int main() {
    char haystack[1000];
    char needle[1000];

    printf("Enter haystack: ");
    scanf("%s", haystack);

    printf("Enter needle: ");
    scanf("%s", needle);

    int result = findFirstOccurrence(haystack, needle);

    printf("Output: %d\n", result);

    return 0;
}
