#include <stdio.h>
#include <string.h>

void longestPalindrome(char s[]) {
    int n = strlen(s);

    int dp[n][n];

    int start = 0;
    int maxLength = 1;

    // Every single character is a palindrome
    for (int i = 0; i < n; i++)
        dp[i][i] = 1;

    // Check substrings of length 2 and more
    for (int length = 2; length <= n; length++) {

        for (int i = 0; i <= n - length; i++) {

            int j = i + length - 1;

            if (s[i] == s[j]) {

                if (length == 2)
                    dp[i][j] = 1;
                else
                    dp[i][j] = dp[i + 1][j - 1];

                if (dp[i][j] && length > maxLength) {
                    start = i;
                    maxLength = length;
                }

            } else {
                dp[i][j] = 0;
            }
        }
    }

    printf("Longest Palindromic Substring: ");

    for (int i = start; i < start + maxLength; i++)
        printf("%c", s[i]);

    printf("\n");
}

int main() {

    char s[1001];

    printf("Enter string: ");
    scanf("%1000s", s);

    longestPalindrome(s);

    return 0;
}
