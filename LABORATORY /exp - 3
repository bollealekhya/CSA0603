#include <iostream>
#include <vector>
#include <set>
using namespace std;

long long sumOfSquares(vector<int>& nums) {
    long long answer = 0;

    // Start from each index
    for (int i = 0; i < nums.size(); i++) {
        set<int> distinct;

        // Extend the subarray from i to j
        for (int j = i; j < nums.size(); j++) {
            distinct.insert(nums[j]);

            // Number of distinct elements
            long long count = distinct.size();

            // Add square of distinct count
            answer += count * count;
        }
    }

    return answer;
}

int main() {
    vector<int> nums1 = {1, 2, 1};
    vector<int> nums2 = {1, 1};

    cout << "Output 1: " << sumOfSquares(nums1) << endl;
    cout << "Output 2: " << sumOfSquares(nums2) << endl;

    return 0;
}
