#include <stdio.h>

typedef struct {
    int x;
    int y;
} Point;

/* Find orientation of three points */
int orientation(Point a, Point b, Point c) {
    int value = (b.y - a.y) * (c.x - b.x)
              - (b.x - a.x) * (c.y - b.y);

    if (value == 0)
        return 0;       // Collinear
    else if (value > 0)
        return 1;       // Clockwise
    else
        return 2;       // Counter-clockwise
}

/* Check whether point c lies on line segment ab */
int onSegment(Point a, Point b, Point c) {
    return (c.x >= (a.x < b.x ? a.x : b.x) &&
            c.x <= (a.x > b.x ? a.x : b.x) &&
            c.y >= (a.y < b.y ? a.y : b.y) &&
            c.y <= (a.y > b.y ? a.y : b.y));
}

/* Brute-force convex hull */
void convexHull(Point points[], int n) {
    int hull[100] = {0};

    /*
       Check every pair of points.
       If all other points lie on the same side of the line,
       the pair represents a convex hull edge.
    */
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {

            int positive = 0;
            int negative = 0;

            for (int k = 0; k < n; k++) {
                if (k == i || k == j)
                    continue;

                int o = orientation(points[i], points[j], points[k]);

                if (o == 1)
                    positive = 1;
                else if (o == 2)
                    negative = 1;
            }

            if (!(positive && negative)) {
                hull[i] = 1;
                hull[j] = 1;
            }
        }
    }

    printf("Convex Hull: ");

    for (int i = 0; i < n; i++) {
        if (hull[i]) {
            printf("(%d, %d) ", points[i].x, points[i].y);
        }
    }

    printf("\n");
}

int main() {

    Point points[] = {
        {1, 1},
        {4, 6},
        {8, 1},
        {0, 0},
        {3, 3}
    };

    int n = sizeof(points) / sizeof(points[0]);

    convexHull(points, n);

    return 0;
}
